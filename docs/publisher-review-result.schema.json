{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Published edition and lifecycle research results v2",
  "type": "object",
  "required": ["schema_version", "run_id", "runner", "results"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{8,100}$" },
    "runner": { "type": "string", "minLength": 1, "maxLength": 150 },
    "results": {
      "type": "array", "minItems": 1, "maxItems": 2000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "expected_hash", "outcome", "note"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "expected_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "outcome": { "enum": ["verified", "unverified"] },
          "note": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "coverage": { "const": "current_published_set" },
          "source_reference": { "type": "string", "minLength": 1, "maxLength": 150 },
          "checked_at": { "type": "string", "format": "date-time" },
          "no_current_published": { "type": "boolean" },
          "lifecycle": {
            "type": "object", "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": { "enum": ["current", "withdrawn"] },
              "withdrawal_confirmed": { "type": "boolean" },
              "withdrawal_date": { "type": ["string", "null"], "format": "date" },
              "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "replacement_status": { "enum": ["known", "none", "unknown"] },
              "replacements": {
                "type": "array", "maxItems": 10,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["reference", "relation", "note", "source_url"],
                  "properties": {
                    "reference": { "type": "string", "minLength": 1, "maxLength": 150 },
                    "relation": { "enum": ["full", "partial"] },
                    "note": { "type": "string", "minLength": 1, "maxLength": 1000 },
                    "source_url": { "type": "string", "format": "uri", "pattern": "^https://" }
                  }
                }
              }
            },
            "allOf": [{ "if": { "properties": { "status": { "const": "withdrawn" } } },
              "then": { "required": ["withdrawal_confirmed", "withdrawal_date", "source_url", "replacement_status", "replacements"],
                "properties": { "withdrawal_confirmed": { "const": true } } } }]
          },
          "evidence": {
            "type": "array", "minItems": 1, "maxItems": 10,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["url", "title", "finding", "retrieved_at"],
              "properties": {
                "url": { "type": "string", "format": "uri", "pattern": "^https://" },
                "title": { "type": "string", "minLength": 1, "maxLength": 300 },
                "finding": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "retrieved_at": { "type": "string", "format": "date-time" }
              }
            }
          },
          "editions": {
            "type": "array", "minItems": 1, "maxItems": 20,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["edition", "status", "source_url"],
              "properties": {
                "edition": { "type": "string", "minLength": 1, "maxLength": 150 },
                "status": { "enum": ["published", "withdrawn", "draft"] },
                "publication_date": { "type": ["string", "null"], "format": "date" },
                "source_url": { "type": "string", "format": "uri", "pattern": "^https://" }
              }
            }
          }
        },
        "allOf": [{ "if": { "properties": { "outcome": { "const": "verified" } } },
          "then": { "required": ["coverage", "source_reference", "checked_at", "evidence", "editions"] } }]
      }
    }
  }
}
